#!/data/data/com.termux/files/usr/bin/bash
set -euo pipefail
ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"; sample=false; prompt=""
if [ "${1:-}" = --sample ]; then sample=true; shift; else prompt="${*:-}"; fi
if [ "$sample" = false ] && [ -z "$prompt" ]; then printf '作りたいアプリを日本語で入力してください: '; IFS= read -r prompt; fi
if [ "$sample" = false ] && [ -z "$prompt" ]; then echo '仕様が空です' >&2; exit 2; fi
build_id="$(date +%Y%m%d-%H%M%S)-$$"; workspace_root="${APPMAKER_WORKSPACE_ROOT:-$HOME/android-ai-appmaker/workspace}"; work="$workspace_root/$build_id"; mkdir -p "$work"
if [ "$sample" = true ]; then
 cp "$ROOT/examples/calculator/AndroidManifest.xml" "$work/"; mkdir -p "$work/src/com/example/calculator"; cp "$ROOT/examples/calculator/src/com/example/calculator/MainActivity.java" "$work/src/com/example/calculator/"
else
 ai_mode="${APPMAKER_AI:-auto}"; codex_ready=false
 if [ "$ai_mode" != none ] && command -v codex >/dev/null 2>&1 && codex login status >/dev/null 2>&1; then codex_ready=true; fi
 [ "$codex_ready" = true ] || { echo 'AIアプリ生成を使うにはOpenAI Codexのログインが必要です' >&2; exit 3; }
 (cd "$work" && "$ROOT/scripts/ai-adapter.sh" exec --full-auto "次の仕様のAndroidアプリのソースをこのディレクトリに生成してください: $prompt. AndroidManifest.xmlとJavaソースだけを生成してください。")
fi
[ -f "$work/AndroidManifest.xml" ] && find "$work" -name '*.java' -print -quit | grep -q . || { echo 'アプリソースの生成に失敗しました' >&2; exit 4; }
out_root="${APPMAKER_OUTPUT_ROOT:-$HOME/android-ai-appmaker/out}/$build_id"; mkdir -p "$out_root"
"$ROOT/builder/build-apk.sh" "$work" "$out_root/app.apk"
[ -s "$out_root/app.apk" ] || { echo 'APKが生成されませんでした' >&2; exit 5; }
ln -sfn "$out_root" "${APPMAKER_OUTPUT_ROOT:-$HOME/android-ai-appmaker/out}/latest"; echo "APKを生成しました: $out_root/app.apk"
